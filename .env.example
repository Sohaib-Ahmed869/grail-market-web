# Copy this file to .env.local before the first `npm run dev`. It is gitignored,
# so a fresh clone has neither variable — and without one of them both the app
# and the console fall back to http://localhost:8180, which is right on exactly
# one machine and silent on every other. Set them.

# Where the backend is, as the browser sees it. Baked into the bundle at
# build time, so a change here needs a rebuild, not just a restart.
#
# local:      http://localhost:8180   (or whatever PORT the API is set to)
# deployed:   https://your-api-host
NEXT_PUBLIC_API_URL=http://localhost:8180

# --- admin console -----------------------------------------------------------
# The API as the console's own server sees it, for the /api/admin proxy.
# Server-side only, so it may point at a host the browser cannot reach, and a
# change is picked up on a restart rather than a rebuild.
#
# If it is unset the server side falls back to NEXT_PUBLIC_API_URL, so setting
# only that one is enough to run everything locally.
#
# There is no admin credential here. The console forwards the operator's own
# session token and the API decides scope from their role — see ADMIN_OWNERS
# and ADMIN_DEV_USER in the backend's .env.example.
GRAILMARKET_API_URL=http://localhost:8180
