# Where the backend is, as the browser sees it. Baked into the bundle at
# build time, so a change here needs a rebuild, not just a restart.
#
# local:      http://localhost:8180
# deployed:   https://your-api-host
NEXT_PUBLIC_API_URL=http://localhost:8180

# --- admin console -----------------------------------------------------------
# The API as the console's own server sees it, for the /api/admin proxy.
# Server-side only, so it may point at a host the browser cannot reach.
#
# There is no admin credential here. The console forwards the operator's own
# session token and the API decides scope from their role — see ADMIN_OWNERS
# and ADMIN_DEV_USER in the backend's .env.example.
GRAILMARKET_API_URL=http://localhost:8180
